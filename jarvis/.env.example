# Jarvis/OpenClaw System - Environment Configuration
# Copy this to .env and fill in your actual credentials

# ============================================
# KOTAK NEO - NSE Options Trading
# ============================================
KOTAK_API_KEY=your_kotak_api_key_here
KOTAK_API_SECRET=your_kotak_api_secret_here
KOTAK_UCC=your_kotak_ucc_here
KOTAK_TOTP_SECRET=your_kotak_totp_secret_here
KOTAK_MPIN=your_kotak_mpin_here
KOTAK_ENV=uat  # or prod for live trading

# ============================================
# KRONOS FOUNDATION MODEL
# ============================================
KRONOS_MODEL=NeoQuasar/Kronos-mini
KRONOS_TOKENIZER=NeoQuasar/Kronos-Tokenizer-2k
KRONOS_MAX_CONTEXT=512

# ============================================
# CRYPTO OPTIONS - Deribit
# ============================================
DERIBIT_CLIENT_ID=your_deribit_client_id
DERIBIT_CLIENT_SECRET=your_deribit_client_secret
DERIBIT_NETWORK=mainnet  # or testnet

# ============================================
# CRYPTO FUNDED ACCOUNT
# ============================================
CRYPTO_FUNDED_API_KEY=your_crypto_funded_api_key
CRYPTO_FUNDED_API_SECRET=your_crypto_funded_api_secret

# ============================================
# FOREX FUNDED ACCOUNT
# ============================================
FOREX_API_KEY=your_forex_api_key
FOREX_API_SECRET=your_forex_api_secret

# ============================================
# JARVIS AI ASSISTANT
# ============================================
JARVIS_API_KEY=your_jarvis_api_key
JARVIS_MODEL_PROVIDER=openrouter  # or openai, anthropic
JARVIS_API_URL=https://openrouter.ai/api/v1

# ============================================
# ADZIGA AGENCY - Sweet Desire
# ============================================
ADZIGA_INSTAGRAM_USERNAME=sweet_desire_uae
ADZIGA_INSTAGRAM_PASSWORD=your_instagram_password
ADZIGA_FACEBOOK_ACCESS_TOKEN=your_facebook_access_token

# ============================================
# SYSTEM CONFIGURATION
# ============================================
ENV=production
TZ=Asia/Kolkata
LOG_LEVEL=INFO

# Trading Limits
MAX_POSITIONS=5
RISK_PER_TRADE=0.01
MAX_LOSS_PER_TRADE=0.02
MAX_DAILY_LOSS=0.05
PROFIT_TARGET=0.10

# Service Ports
KOTAK_CORE_PORT=8510
KRONOS_PORT=8506
CRYPTO_OPTIONS_PORT=8511
CRYPTO_FUNDED_PORT=8512
FOREX_FUNDED_PORT=8513
JARVIS_PORT=8080
ADZIGA_PORT=8090
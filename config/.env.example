# =================================================================
# Kotak Neo Trading Bot — environment overrides example
# Copy this file to `config/.env` (or load it into your shell) and
# adjust as needed. Variables here override anything in settings.yaml
# when the bot reads them via os.environ.
# =================================================================

# ---- Kotak Neo API (used by live_kotak mode) ----
# Get from Kotak Neo mobile app: More → Trade API → Create New Application
KOTAK_API_KEY=
KOTAK_ENV=uat                                # 'uat' or 'prod'
KOTAK_MOBILE=+91                             # registered mobile (e.g. +91XXXXXXXXXX)
KOTAK_UCC=                                   # 5-char client code (e.g. ABC12)
KOTAK_MPIN=                                  # trading MPIN

# TOTP: get the secret by enrolling in Google Authenticator
# More → Trade API → TOTP setup → scan QR → the secret is in the otpauth:// URL
KOTAK_TOTP_SECRET=
KOTAK_PROD_POLL_SEC=2.0                      # poll interval for live_kotak mode

# ---- Deribit (used by live_deribit mode — crypto options paper trading) ----
# Public market data needs NO auth. For paper trading on testnet, defaults below are fine.
# For live trading on prod, set DERIBIT_CLIENT_ID and DERIBIT_CLIENT_SECRET (future use).
DERIBIT_ENV=testnet                          # 'testnet' (default, no real money) or 'prod'
DERIBIT_CURRENCIES=BTC,ETH                   # comma-separated underlyings to poll
DERIBIT_POLL_SEC=2.0                         # poll interval for live_deribit mode
# DERIBIT_CLIENT_ID=...                      # auth — only required for live trading later
# DERIBIT_CLIENT_SECRET=...                  # auth — only required for live trading later

# ---- Data vendor (optional, for paid intraday historical) ----
# Sign up at truedata.in, copy API key from dashboard
TRUEDATA_API_KEY=

# ---- LLM (for news sentiment judge) ----
# Get from console.anthropic.com or platform.openai.com
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Telegram alerts ----
# 1. Talk to @BotFather on Telegram
# 2. /newbot → follow prompts → copy the token
# 3. Send any message to your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
# 4. Find your chat.id in the response
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Email alerts (Gmail App Password) ----
# Gmail → Manage account → Security → 2FA → App passwords → generate
ALERT_EMAIL_USER=
ALERT_EMAIL_PASSWORD=
ALERT_EMAIL_TO=

# ---- News API (optional, for richer news coverage) ----
# Sign up at marketaux.com (free 100 req/day with built-in sentiment)
MARKETAUX_API_KEY=

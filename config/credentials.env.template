# =================================================================
# Kotak Neo Trading Bot — credentials template
# Copy this file to `config/credentials.env` and fill in your values
# NEVER commit credentials.env to git (it's already in .gitignore)
# =================================================================

# ---- Kotak Neo API ----
# Get from Kotak Neo mobile app: More → Trade API → Create New Application
KOTAK_API_KEY=
KOTAK_ENV=prod                              # 'prod' or 'uat'
KOTAK_MOBILE=+91                            # registered mobile
KOTAK_UCC=                                  # client code, e.g. ABC12
KOTAK_MPIN=                                 # trading MPIN

# TOTP: get the secret by enrolling in Google Authenticator
# More → Trade API → TOTP setup → scan QR → the secret is in the otpauth:// URL
# Or set KOTAK_TOTP_CODE for a one-time code (expires every 30s, bad for auto-login)
KOTAK_TOTP_SECRET=

# ---- Data vendor (optional, for paid intraday historical) ----
# Sign up at truedata.in, copy API key from dashboard
TRUEDATA_API_KEY=

# ---- LLM (for news sentiment judge) ----
# Get from console.anthropic.com or platform.openai.com
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---- Telegram alerts ----
# 1. Talk to @BotFather on Telegram
# 2. /newbot → follow prompts → copy the token
# 3. Send any message to your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
# 4. Find your chat.id in the response
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Email alerts (Gmail App Password) ----
# Gmail → Manage account → Security → 2FA → App passwords → generate
ALERT_EMAIL_USER=
ALERT_EMAIL_PASSWORD=
ALERT_EMAIL_TO=

# ---- News API (optional, for richer news coverage) ----
# Sign up at marketaux.com (free 100 req/day with built-in sentiment)
MARKETAUX_API_KEY=
